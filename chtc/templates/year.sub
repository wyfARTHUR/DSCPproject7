universe = container
container_image = @CONTAINER_IMAGE@
executable = job.sh
arguments = year $(year)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = code.tar.gz
transfer_output_files = year-$(year).rds
request_cpus = 2
request_memory = 8GB
request_disk = 8GB
environment = "DSCP_CPUS=2 DSCP_JOB_ID=$(Cluster).$(Process)"
log = logs/year_$(Cluster).log
output = logs/year_$(Cluster)_$(Process).out
error = logs/year_$(Cluster)_$(Process).err
requirements = (HasCHTCStaging == true)
queue year from years.txt
