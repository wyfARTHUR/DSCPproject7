universe = container
container_image = @CONTAINER_IMAGE@
executable = job.sh
arguments = audit 0 @ALLOW_UNREVIEWED@
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = code.tar.gz, review-bundle.rds, match_review.tsv
transfer_output_files = audit-ok.rds
request_cpus = 1
request_memory = 4GB
request_disk = 8GB
environment = "DSCP_CPUS=1 DSCP_JOB_ID=$(Cluster).$(Process)"
log = logs/audit_$(Cluster).log
output = logs/audit_$(Cluster)_$(Process).out
error = logs/audit_$(Cluster)_$(Process).err
requirements = (HasCHTCStaging == true)
queue
